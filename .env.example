# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# === Media/LLM провайдеры (заглушки в Фазе 0, заполнятся в Фазе 1) ===
FAL_KEY=
OPENROUTER_API_KEY=

# === Feature flags / DI ===
MEDIA_PROVIDER=mock
LLM_PROVIDER=mock

# === ElevenLabs ===
# Default narrator voice for TTS. ElevenLabs voice_id (Rachel placeholder).
# Override with your team's narrator voice in production.
MANGO_DEFAULT_NARRATOR_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === Phase 1.3.5: cost guard ===
# Soft warning threshold in USD. UI shows warning when project cost meter
# crosses this value. Hard cap is enforced separately by the 5-version cap
# per asset slot.
MANGO_COST_WARN_THRESHOLD_USD=10
# Public mirror used by the client-side toast (must match server threshold).
NEXT_PUBLIC_COST_WARN_THRESHOLD_USD=10

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Phase 1.6: Identity Foundation ===
# Master switch for the auth UI (/login page, AccountMenu, ClaimWorkBanner,
# TierGateModal). When 'false', /login returns 404 and the AccountMenu /
# ClaimWorkBanner render nothing. Existing anonymous middleware keeps
# working independently. Flip to 'true' AFTER SMTP + DNS + Supabase Auth
# dashboard config are live (Phase 1.6 sub-phase F).
NEXT_PUBLIC_AUTH_UI_ENABLED=false

# Server-side enforcement switch for assertCapability. When 'true', the
# tier gate blocks gated actions; when 'false', the gate logs the would-be
# block and lets the call through. Use 'false' during canary observation
# (Phase 1.6 G2 / H2), flip to 'true' once logs confirm getAccountTier is
# reading correctly.
AUTH_GATE_ENFORCE=false
